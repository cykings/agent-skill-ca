# 复制本文件为 ~/.config/gmgn/.env (Linux/Mac) 或 C:\Users\<你>\.config\gmgn\.env (Windows)
# 然后填入你的 API key

# ===== 必填 =====

# gmgn OpenAPI key — 申请: https://gmgn.ai/ai
GMGN_API_KEY=

# DeepSeek (默认 LLM 后端,最便宜 ~$0.002/次) — 申请: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ===== 强烈建议补全 =====
# 没这两个,报告里的 X 推文素材会全部缺失,叙事质量大幅下降

# 6551 OpenTwitter — 申请: https://6551.io/mcp
OPENTWITTER_TOKEN=

# twitterapi.io (仅当代币挂 X Community 时启用) — 申请: https://twitterapi.io
TWITTERAPI_IO_KEY=

# ===== 可选 =====

# Grok / xAI (仅 --llm grok 时需要) — 申请: https://x.ai/api
XAI_API_KEY=
